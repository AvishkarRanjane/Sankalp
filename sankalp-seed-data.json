  "faqs": [
    {
      "id": "faq_01",
      "audience": "backers",
      "question": "Is my money safe?",
      "answer": "Your contribution is held by a smart contract and released to the creator only after milestones are approved. No system is risk-free; see the Risk Disclosure."
    },
    {
      "id": "faq_02",
      "audience": "backers",
      "question": "What happens if a project doesn't reach its goal?",
      "answer": "The campaign fails and every backer can claim a full refund from the contract."
    },
    {
      "id": "faq_03",
      "audience": "backers",
      "question": "Do I need to understand crypto to contribute?",
      "answer": "You need a wallet and USDC. Our guide walks you through it in about 10 minutes."
    },
    {
      "id": "faq_04",
      "audience": "backers",
      "question": "Why do I need MON as well as USDC?",
      "answer": "MON pays the small network fee for each transaction on Monad."
    },
    {
      "id": "faq_05",
      "audience": "creators",
      "question": "How much does it cost to start?",
      "answer": "Nothing upfront. A flat 3% fee applies only to successfully funded campaigns."
    },
    {
      "id": "faq_06",
      "audience": "creators",
      "question": "How are funds released to me?",
      "answer": "You submit proof for each milestone. After approval, that portion becomes withdrawable."
    },
    {
      "id": "faq_07",
      "audience": "creators",
      "question": "Can I change my goal or deadline after launch?",
      "answer": "No. Rules are fixed at launch to protect backers."
    },
    {
      "id": "faq_08",
      "audience": "creators",
      "question": "What projects are not allowed?",
      "answer": "Illegal items, weapons, gambling, adult content, investment or profit-sharing offers, and individual medical fundraising."
    }
  ],
