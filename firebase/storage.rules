rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read for project images, milestone proof, and avatars
    match /{allPaths=**} {
      allow read: if true;
    }

    // Authenticated creators can upload project media (limit max 10MB per file)
    match /projects/{projectId}/{fileName} {
      allow write: if request.auth != null 
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
    }

    // Milestone proof uploads
    match /proofs/{projectId}/{fileName} {
      allow write: if request.auth != null
        && request.resource.size < 25 * 1024 * 1024;
    }
  }
}
