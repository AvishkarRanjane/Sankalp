<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 675" width="1200" height="675">
  <defs>
    <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f59e0b" stop-opacity="0.9" />
      <stop offset="50%" stop-color="#0f172a" stop-opacity="0.95" />
      <stop offset="100%" stop-color="#6366f1" stop-opacity="0.8" />
    </linearGradient>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(255,255,255,0.04)" stroke-width="1"/>
    </pattern>
  </defs>
  <rect width="1200" height="675" fill="#090d16" />
  <rect width="1200" height="675" fill="url(#grad)" />
  <rect width="1200" height="675" fill="url(#grid)" />
  
  <g transform="translate(100, 200)">
    <circle cx="90" cy="90" r="75" fill="rgba(255,255,255,0.08)" stroke="rgba(255,255,255,0.15)" stroke-width="2"/>
    <text x="90" y="112" font-size="64" text-anchor="middle" font-family="system-ui, sans-serif">संक</text>
    
    <text x="210" y="70" font-size="52" font-weight="800" fill="#ffffff" font-family="system-ui, sans-serif" letter-spacing="-1">Sankalp: Milestone Crowdfunding</text>
    <text x="210" y="125" font-size="24" font-weight="400" fill="#94a3b8" font-family="system-ui, sans-serif">Fund ideas that keep their promises on the Monad Blockchain</text>
  </g>

  <!-- Monad Badge -->
  <g transform="translate(100, 520)">
    <rect width="320" height="44" rx="12" fill="rgba(15,23,42,0.8)" stroke="rgba(255,255,255,0.1)" stroke-width="1"/>
    <circle cx="24" cy="22" r="6" fill="#10b981"/>
    <text x="40" y="28" font-size="14" font-weight="600" fill="#e2e8f0" font-family="system-ui, sans-serif">Monad Testnet (10143) • Escrow Verified</text>
  </g>
</svg>